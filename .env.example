# =======================================================
# FamilyHubs Production & Development Configuration
# =======================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (SQLite with WAL mode)
# In production, specify an absolute persistent volume path
DB_PATH=./server/familyhubs.db

# Database Migration & Persistence
# Set to 'true' ONLY in testing to wipe preloaded mock records on start.
# Keep 'false' in staging and production to guarantee data persistence.
RESET_DB_ON_START=false

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed client origins or '*' for wildcard
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Payload Size Limits (for GPS-watermarked camera verification photos)
MAX_PAYLOAD_SIZE=25mb

# Security & Operations Defaults
DEFAULT_ESCROW_RELEASE_PIN=849201
DEFAULT_GEOFENCE_TOLERANCE_METERS=150

# Client Application API & WebSocket URLs (optional overrides)
# When left unset, client applications automatically resolve endpoints
# VITE_API_URL=https://api.familyhubs.com
# VITE_WS_URL=wss://api.familyhubs.com/ws/events
