# =======================================================
# FamilyHubs Production & Development Configuration
# =======================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (SQLite with WAL mode)
# In production, specify an absolute persistent volume path
DB_PATH=./server/familyhubs.db

# Database Migration & Persistence
# Set to 'true' ONLY in testing to wipe preloaded mock records on start.
# Keep 'false' in staging and production to guarantee data persistence.
RESET_DB_ON_START=false

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed client origins or '*' for wildcard
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Payload Size Limits (for GPS-watermarked camera verification photos)
MAX_PAYLOAD_SIZE=25mb

# Security & Operations Defaults
ESCROW_RELEASE_PIN=
DEFAULT_GEOFENCE_TOLERANCE_METERS=150

# Supabase Cloud Database & Storage Configuration (optional cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Client Application API & WebSocket URLs (optional overrides)
# When left unset, client applications automatically resolve endpoints
# VITE_API_URL=https://api.familyhubs.com
# VITE_WS_URL=wss://api.familyhubs.com/ws/events



# Enable only behind a trusted reverse proxy
TRUST_PROXY=false
# Use HTTPS in production; sessions use Secure cookies on HTTPS requests
# ADMIN_PASSWORD is required by the offline admin-provisioning script only.
ADMIN_PASSWORD=

# Manual WhatsApp is the default. Enable automatic delivery only when intentionally configured.
WHATSAPP_AUTOMATIC_ENABLED=false

# Meta WhatsApp Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to the supported API version in your Meta application
WHATSAPP_GRAPH_VERSION=
# Approved utility template: a single body parameter {{1}} containing request reference + event
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Webhook URL: https://your-domain/api/whatsapp/webhook
